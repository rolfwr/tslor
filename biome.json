{
  "$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
  "formatter": {
    "enabled": false
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "suspicious": {
        "noImportCycles": { "level": "error" },
        "noExtraNonNullAssertion": { "level": "error" }
      },
      "style": {
        "noNonNullAssertion": { "level": "error" }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        },
        "useMaxParams": {
          "level": "error",
          "options": { "max": 7 }
        }
      }
    }
  }
}
